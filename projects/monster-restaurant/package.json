{
  "name": "monster-restaurant-bedrock",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:models": "python assets/blockbench/build_models.py",
    "build:addon": "python tools/build_addon.py",
    "build:engine-tests": "python tools/build_gametest.py",
    "test:engine": "npm run build:engine-tests && bc-bds run --packs build/gametest-packs --tag monster_restaurant --expect-registered 7 --json .bds/logs/monster-restaurant-results.json",
    "deploy:client-dev-packs": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy_client_dev_packs.ps1"
  },
  "devDependencies": {
    "@bedrock-core/bds-runner": "0.2.1"
  }
}
