{
  "schemaVersion": 1,
  "rules": {
    "defaultMode": "vendored",
    "namespace": "lb",
    "targetPrefix": "reward_",
    "externalRuntimeDependencyPolicy": "Avoid unless an upstream add-on must remain separate. Separate BP script realms cannot import each other directly.",
    "sourcePinning": "Every active source is pinned to a reviewed Git commit SHA.",
    "collisionPolicy": "All imported identifiers and file names are remapped into the lb namespace before entering BP/RP.",
    "licensePolicy": "vendored assets require verified redistribution/modification permission; reference-only sources never enter distributable packs."
  },
  "sources": {
    "microsoft_minecraft_samples": {
      "url": "https://github.com/microsoft/minecraft-samples",
      "license": "MIT",
      "reviewedRef": "main",
      "reviewedCommit": "5e04b6f719c316b0611f569af0cab7d6e9a2fb26",
      "integrationMode": "vendored"
    },
    "corvae_pylon": {
      "url": "https://github.com/CorvaeOboro/minecraft_botania_pylon_crystal",
      "license": "CC0-1.0",
      "reviewedRef": "main",
      "reviewedCommit": "7a0d28235188131313bfa4b20684549d3ac15528",
      "integrationMode": "vendored"
    },
    "loys_goodies": {
      "url": "https://github.com/SL0ANE/Loy-s-Goodies",
      "license": "CC0-1.0",
      "reviewedRef": "main",
      "reviewedCommit": "afbb7695b09de0ed8ee3aa97732ff7c3d367520c",
      "integrationMode": "vendored"
    }
  },
