{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lb.sky_damselfly_mount.locomotion": {
      "initial_state": "ground",
      "states": {
        "ground": {
          "animations": [
            "perch"
          ],
          "transitions": [
            {
              "flight": "!query.is_on_ground"
            }
          ]
        },
        "flight": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "ground": "query.is_on_ground"
            }
          ]
        }
      }
    }
  }
}
