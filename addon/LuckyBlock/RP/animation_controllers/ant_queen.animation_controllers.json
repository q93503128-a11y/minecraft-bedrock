{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lb.ant_queen.locomotion": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.01"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "query.modified_move_speed <= 0.01"
            }
          ]
        }
      }
    }
  }
}
